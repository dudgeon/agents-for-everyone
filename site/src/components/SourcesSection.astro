---
import type { Source } from '@/data/chapters';

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;
---
{sources.length > 0 && (
  <details class="group border-b border-border/50">
    <summary class="flex cursor-pointer list-none items-center justify-between py-4 text-sm font-medium text-muted-foreground hover:text-foreground [&::-webkit-details-marker]:hidden">
      Sources & References
      <svg
        class="h-4 w-4 shrink-0 transition-transform duration-200 group-open:rotate-180"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="m6 9 6 6 6-6" />
      </svg>
    </summary>
    <div class="pb-4">
      <ul class="space-y-2">
        {sources.map((source) => (
          <li class="flex items-start gap-2 text-xs leading-relaxed text-muted-foreground sm:text-sm">
            <span class="shrink-0 text-accent">&bull;</span>
            <span>
              {source.idea} &mdash;{' '}
              <a
                href={source.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-primary underline decoration-primary/30 underline-offset-2 transition-colors hover:text-accent hover:decoration-accent/50"
              >
                {source.name}
                <svg
                  class="h-3 w-3"
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M15 3h6v6" />
                  <path d="M10 14 21 3" />
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                </svg>
              </a>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </details>
)}
