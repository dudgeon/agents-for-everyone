---
import type { ChapterData } from '@/data/chapters';
import IllustrationPanels from './IllustrationPanels.astro';
import SourcesSection from './SourcesSection.astro';

interface Props {
  chapter: ChapterData;
}

const { chapter } = Astro.props;
---
<section id={chapter.id} class="relative">
  {/* Sticky title */}
  <div class="sticky top-[44px] z-40 flex min-h-[10vh] items-center border-b border-border/30 bg-background/95 px-4 py-4 backdrop-blur-sm sm:top-[52px] sm:px-6 md:px-8">
    <div class="mx-auto w-full max-w-4xl">
      <span class="mb-1 block text-xs font-semibold uppercase tracking-widest text-accent sm:text-sm">
        Chapter {chapter.number}
      </span>
      <h2 class="font-display text-xl font-bold leading-snug text-chapter-title sm:text-2xl md:text-3xl lg:text-4xl">
        {chapter.title}
      </h2>
    </div>
  </div>

  {/* Content */}
  <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12 md:px-8 md:py-16">
    {/* Illustration panels */}
    {chapter.panels.length > 0 && <IllustrationPanels panels={chapter.panels} />}

    {/* Body text */}
    <div class="mx-auto mt-8 max-w-[65ch] space-y-5 sm:mt-12">
      {chapter.body.map((paragraph) => (
        <p class="text-base leading-[1.8] text-foreground/90 sm:text-lg sm:leading-[1.85]">
          {paragraph}
        </p>
      ))}
    </div>

    {/* Sources */}
    <div class="mx-auto mt-8 max-w-[65ch] sm:mt-12">
      <SourcesSection sources={chapter.sources} />
    </div>
  </div>
</section>
