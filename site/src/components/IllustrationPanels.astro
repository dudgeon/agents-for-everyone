---
import type { Panel } from '@/data/chapters';

interface Props {
  panels: Panel[];
}

const { panels } = Astro.props;

const gradientStyles: Record<string, string> = {
  warm: 'from-panel-warm to-panel-cool',
  cool: 'from-panel-cool to-panel-warm',
  'warm-accent': 'from-panel-warm via-accent/10 to-panel-cool',
  'cool-accent': 'from-panel-cool via-accent/10 to-panel-warm',
};

const textureSvg = `url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23000000' fill-opacity='1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E")`;
---
{panels.length > 0 && (
  <div class="w-full">
    {/* Desktop: side by side */}
    <div class="hidden md:grid md:grid-cols-2 md:gap-4">
      {panels.map((panel) => (
        <div
          class:list={[
            'relative flex aspect-[4/3] flex-col justify-end overflow-hidden rounded-lg border border-panel-border bg-gradient-to-br p-6',
            gradientStyles[panel.gradient],
          ]}
        >
          <div class="absolute inset-0 opacity-[0.03]" style={{ backgroundImage: textureSvg }} />
          {panel.image && (
            <img
              src={panel.image}
              alt={panel.label}
              class="absolute inset-0 h-full w-full object-cover"
            />
          )}
          {!panel.image && (
            <div class="relative z-10">
              <h3 class="font-display text-lg font-bold text-foreground">{panel.label}</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{panel.description}</p>
            </div>
          )}
          {panel.image && panel.dialogue && (
            <div class="relative z-10 max-w-[70%] self-start">
              <div class="rounded-2xl bg-white/90 px-3 py-2 text-sm font-medium leading-snug text-gray-900 shadow-md backdrop-blur-sm">
                {panel.dialogue}
              </div>
            </div>
          )}
        </div>
      ))}
    </div>

    {/* Mobile: carousel */}
    <div class="panel-carousel md:hidden">
      <div class="overflow-hidden rounded-lg border border-panel-border">
        <div class="panel-track flex transition-transform duration-300 ease-out">
          {panels.map((panel) => (
            <div
              class:list={[
                'relative flex aspect-[4/3] w-full shrink-0 flex-col justify-end bg-gradient-to-br p-5',
                gradientStyles[panel.gradient],
              ]}
            >
              <div class="absolute inset-0 opacity-[0.03]" style={{ backgroundImage: textureSvg }} />
              {panel.image && (
                <img
                  src={panel.image}
                  alt={panel.label}
                  class="absolute inset-0 h-full w-full object-cover"
                />
              )}
              {!panel.image && (
              <div class="relative z-10">
                <h3 class="font-display text-base font-bold text-foreground">{panel.label}</h3>
                <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{panel.description}</p>
              </div>
              )}
              {panel.image && panel.dialogue && (
                <div class="relative z-10 max-w-[70%] self-start">
                  <div class="rounded-2xl bg-white/90 px-3 py-2 text-sm font-medium leading-snug text-gray-900 shadow-md backdrop-blur-sm">
                    {panel.dialogue}
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
      {/* Dots */}
      <div class="mt-3 flex justify-center gap-2">
        {panels.map((_, i) => (
          <button
            data-dot={i}
            class:list={[
              'dot h-2 rounded-full transition-all',
              i === 0 ? 'w-6 bg-accent' : 'w-2 bg-border',
            ]}
            aria-label={`View panel ${i + 1}`}
          />
        ))}
      </div>
    </div>
  </div>
)}

<script>
  document.querySelectorAll('.panel-carousel').forEach((carousel) => {
    const track = carousel.querySelector('.panel-track') as HTMLElement;
    const dots = carousel.querySelectorAll('.dot');
    if (!track || dots.length === 0) return;

    let active = 0;
    const total = dots.length;

    function goTo(index: number) {
      active = Math.max(0, Math.min(index, total - 1));
      track.style.transform = `translateX(-${active * 100}%)`;
      dots.forEach((d, j) => {
        d.classList.toggle('w-6', j === active);
        d.classList.toggle('bg-accent', j === active);
        d.classList.toggle('w-2', j !== active);
        d.classList.toggle('bg-border', j !== active);
      });
    }

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => goTo(i));
    });

    // Touch swipe support
    let touchStartX = 0;
    let touchStartY = 0;

    track.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.touches[0].clientX;
      touchStartY = e.touches[0].clientY;
    }, { passive: true });

    track.addEventListener('touchend', (e: TouchEvent) => {
      const dx = e.changedTouches[0].clientX - touchStartX;
      const dy = e.changedTouches[0].clientY - touchStartY;
      // Only trigger if horizontal swipe dominates and exceeds threshold
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
        goTo(dx < 0 ? active + 1 : active - 1);
      }
    }, { passive: true });
  });
</script>
